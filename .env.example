# API base URL for backend functions.
# Use the Vercel project URL (always has /api/* functions), even when the
# static site is served from GitHub Pages (which has no serverless functions).
VITE_API_BASE=https://ebook-store-ansygroups-projects.vercel.app

# Stripe secret key (LIVE mode) — enables the per-book Payment Link generator.
# auto-complete.mjs reads .env then .env.local on every cron run; the moment a
# live key (sk_live_..., NOT sk_test_...) appears it creates one unique
# https://buy.stripe.com link per book and commits the result.
# Get it from https://dashboard.stripe.com/apikeys  (leave this commented out
# until you have a live key - an uncommented placeholder would just error).
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
